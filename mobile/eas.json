{
  "cli": {
    "version": ">= 19.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pdv-api-dev.niceground-cc94fda7.eastus.azurecontainerapps.io",
        "EXPO_PUBLIC_LOG_LEVEL": "debug",
        "EXPO_PUBLIC_LOG_ENABLED": "true",
        "EXPO_PUBLIC_LOG_SHIP_ENABLED": "false"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pdv-api-staging.niceground-cc94fda7.eastus.azurecontainerapps.io",
        "EXPO_PUBLIC_LOG_LEVEL": "info",
        "EXPO_PUBLIC_LOG_ENABLED": "true",
        "EXPO_PUBLIC_LOG_SHIP_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pdv-api.niceground-cc94fda7.eastus.azurecontainerapps.io",
        "EXPO_PUBLIC_LOG_LEVEL": "warn",
        "EXPO_PUBLIC_LOG_ENABLED": "true",
        "EXPO_PUBLIC_LOG_SHIP_ENABLED": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
