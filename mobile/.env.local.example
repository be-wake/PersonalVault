# ── Mobile local-dev environment ─────────────────────────────────────────────
#
# Copy this file to  .env.local  (already gitignored via .env*.local rule).
# Expo SDK 54 reads .env.local automatically when you run  npx expo start.
#
# Choose the right URL for your setup:
#
#   iOS Simulator (Mac):
#     EXPO_PUBLIC_API_URL=http://localhost:5000
#
#   Android Emulator (Windows/Linux):
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#     (The emulator's "localhost" is the emulator itself; 10.0.2.2 is the host)
#
#   Physical device on the same Wi-Fi network:
#     EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
#     (replace with your machine's LAN IP — run  ipconfig  to find it)
#
#   Expo tunnel (works for any device, no IP needed):
#     npx expo start --tunnel
#     and leave EXPO_PUBLIC_API_URL unset to keep production default
# ─────────────────────────────────────────────────────────────────────────────

# Android Emulator default (Windows host). Change for other setups (see above).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# Logging (verbose locally, quieter in production EAS builds)
EXPO_PUBLIC_LOG_LEVEL=debug
EXPO_PUBLIC_LOG_ENABLED=true
EXPO_PUBLIC_LOG_SHIP_ENABLED=false
