# Copy this to .env and adjust for local development.
# All EXPO_PUBLIC_* values are baked into the bundle at build time.

# Backend API base URL. Point this at your local backend (http://10.0.2.2:4000
# on the Android emulator, or your dev tunnel URL on a physical device).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Logger
EXPO_PUBLIC_LOG_LEVEL=debug         # error | warn | info | debug
EXPO_PUBLIC_LOG_ENABLED=true        # true | false
EXPO_PUBLIC_LOG_SHIP_ENABLED=false  # true to forward logs to the backend
