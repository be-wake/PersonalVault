# ── Database ──────────────────────────────────────────────────────────────────
# Azure PostgreSQL Flexible Server connection string.
# Local dev: use a local Postgres instance or Docker (see README).
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://pdvadmin:change-me@localhost:5432/pdv

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of extra allowed origins (in addition to localhost)
ALLOWED_ORIGINS=https://your-frontend.azurecontainerapps.io

# ── Logging ───────────────────────────────────────────────────────────────────
# Level: error | warn | info | debug | trace   (default: info in prod, debug in dev)
LOG_LEVEL=debug

# Set to 'false' to silence all output (e.g. during tests)
LOG_ENABLED=true

# Pretty-print logs (default: true in dev, false in prod)
# In production (NODE_ENV=production) this is always false even if set to true,
# because pino-pretty is not installed in the production Docker image.
LOG_PRETTY=true
