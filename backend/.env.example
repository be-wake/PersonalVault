# ── Database ──────────────────────────────────────────────────────────────────
# Azure PostgreSQL Flexible Server connection string.
# Local dev: use a local Postgres instance or Docker (see backend/README.md).
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://pdvadmin:change-me@localhost:5432/pdv

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production. Server refuses to start without a strong value.
JWT_SECRET=change-me-in-production-min-32-chars-recommended
# Separate secret for refresh tokens — must NOT equal JWT_SECRET.
JWT_REFRESH_SECRET=change-me-in-production-different-from-jwt-secret
# Secret for short-lived step-up tokens (PIN / biometric confirmation).
STEPUP_SECRET=change-me-in-production-different-again
# Secret for RP client_credentials access tokens.
RP_TOKEN_SECRET=change-me-in-production-rp-different

# ── Encryption (field-level) ──────────────────────────────────────────────────
# Base64-encoded 32-byte master key (used as the KEK for field DEKs).
# Production: this is sourced from Azure Key Vault — do NOT set here.
PDV_FIELD_KEK_BASE64=

# ── Azure integrations (optional in local dev) ────────────────────────────────
# Set in production via Key Vault references; leave blank for local dev to use
# the in-memory fallback implementations.
AZURE_KEY_VAULT_URL=
REDIS_CONNECTION_STRING=
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_TOPIC_REVOCATION=pdv-revocation-events

# ── Webhook delivery ──────────────────────────────────────────────────────────
# HMAC secret used to sign RP revocation webhook bodies (X-PDV-Signature header).
WEBHOOK_HMAC_SECRET=change-me-in-production-webhook

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to localhost in dev).
ALLOWED_ORIGINS=https://your-frontend.azurecontainerapps.io

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_LOGS_WINDOW_MS=60000
RATE_LIMIT_LOGS_MAX=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_ENABLED=true
LOG_PRETTY=true

# ── Region / data localisation ────────────────────────────────────────────────
# Surface in /v1/meta so the UI can show it. DPDPA S.17 — set to an India region
# (e.g. centralindia, southindia) when serving Indian principals.
DEPLOYMENT_REGION=eastus
GRIEVANCE_OFFICER_EMAIL=grievance@example.com
