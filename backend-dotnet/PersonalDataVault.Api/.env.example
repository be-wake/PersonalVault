# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (same as the Node backend)
DATABASE_URL=postgresql://user:password@localhost:5432/pdv?sslmode=disable

# JWT secrets (>= 32 chars, must differ from each other)
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
STEPUP_SECRET=your-stepup-secret-here

# Field-level encryption key (32 raw bytes, base64-encoded)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PDV_FIELD_KEK_BASE64=your-field-kek-base64-here

# HMAC secret for outgoing webhooks
WEBHOOK_HMAC_SECRET=your-webhook-secret-here

# ── Optional ──────────────────────────────────────────────────────────────────

# Azure Key Vault (if set, secrets are loaded from KV instead of env vars)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

# Redis (falls back to in-memory if not set)
# REDIS_CONNECTION_STRING=rediss://:password@your-redis.redis.cache.windows.net:6380

# Azure Service Bus (falls back to in-process EventEmitter if not set)
# SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://...
# SERVICE_BUS_TOPIC_REVOCATION=pdv-revocation-events

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Step-up enforcement (true = clients MUST present X-PDV-Stepup header for sensitive ops)
# STEPUP_ENFORCED=false

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:3001
