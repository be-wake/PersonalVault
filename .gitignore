# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# ── SQLite database ───────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────────────────────────────────────────
# Ignore VS Code workspace settings but KEEP launch.json (run configs) and
# extensions.json (recommended extensions) — both are useful for teammates.
**/.vscode/*
!**/.vscode/launch.json
!**/.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── .NET build outputs ────────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.nupkg
*.snupkg

# ── Mobile signing secrets ─────────────────────────────────────────────────────
# Android — handled in mobile-flutter/android/.gitignore (key.properties, *.jks)
# iOS
*.p8
*.p12
*.cer
*.mobileprovision
*.certSigningRequest
ExportOptions.plist

# ── Misc ──────────────────────────────────────────────────────────────────────
.cache/
dist/
